# Copy to .env.local for local work. `vercel env pull --environment=production .env.local`
# fills it from the Vercel project; a plain `vercel env pull` reads the Development
# environment, which is empty unless Development was ticked for the variables.
# Never commit real values. All of these are server-only — none is prefixed
# NEXT_PUBLIC_, so none reaches the browser bundle.

# --- Supabase -----------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
# Acts as the signed-in reader; RLS does the work.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Bypasses RLS. Used by the pipeline (cron + link ingest) and, after their own
# checks, the translate, re-extract and /media routes.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Models -------------------------------------------------------------------
# Which model runs which task is NOT here: see the model_settings table.
# Google AI Studio → Get API key. Curation, summaries, YouTube understanding,
# PDF transcription and translation.
GEMINI_API_KEY=xxx
# Optional. console.groq.com. As seeded: the cheap pre-filter of the daily
# candidates and the ingest cleanup pass; without it those tasks run on their
# Gemini fallback.
GROQ_API_KEY=gsk_xxx

# --- Pipeline -----------------------------------------------------------------
# Any long random string (`openssl rand -hex 32`). Vercel Cron sends it as a Bearer token.
CRON_SECRET=xxx
# Optional. A fine-grained token with no scopes raises the GitHub API rate limit
# for the daily repo search and the GitHub extractor.
GITHUB_TOKEN=
